{
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./",
      "module": "CommonJS",
      "target": "ES2020",
      "lib": ["es6"],
      "moduleResolution": "node",
      "esModuleInterop": true,
      "types": ["node"],
      "strict": true,
      "skipLibCheck": true,
      "baseUrl": ".", // Set baseUrl to root directory
      "paths": {
        "@/*": ["./*"] // Alias "@" points to "src" folder
      }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
  }